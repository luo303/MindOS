# ============================================================================
# MindOS 本地开发配置模板
#
# 用法：cp .env.example .env，然后按需修改。.env 已被 .gitignore 忽略，
# 真实密码与模型 API Key 永远不要提交到仓库。
#
# 优先级：进程环境变量 > .env 文件 > 代码默认值。
# 容器环境中由 compose 直接注入环境变量，此时不需要 .env。
#
# 规则：这里只列代码（或 compose）真的会读取的项。新增配置必须与读取它的
# 那次提交一起落地，不允许先摆占位项。
# ============================================================================

# ---------- 应用 ----------
APP_ENV=dev                 # dev | prod
HTTP_ADDR=:8080             # HTTP 监听地址
SHUTDOWN_TIMEOUT=10s        # 优雅关闭的最长等待时间

# ---------- 账号与会话 ----------
# 会话的绝对有效期（不滑动续期）。默认 30 天。
AUTH_SESSION_TTL=720h
# 是否允许自助注册：open | closed。默认 closed。
# 向量模型是部署者付费的全局配置，公网开放注册等于开放这份额度；
# 本地开发需要注册时临时改成 open，注册完改回 closed。
AUTH_REGISTRATION=closed
# 可信的前端来源，逗号分隔，形如 http://localhost:5173（不带路径）。
# 只在"前端与 API 不同源、且反向代理改写了 Host"时才需要：
# 默认校验是拿 Origin 和请求 Host 比对，Vite 的 changeOrigin=false 与
# nginx 透传 Host 都能让它们相等，此时留空即可。
AUTH_ALLOWED_ORIGINS=

# ---------- 日志 ----------
LOG_LEVEL=debug             # debug | info | warn | error
LOG_FORMAT=console          # console（人读）| json（机器读，生产用）

# ---------- PostgreSQL（含 pgvector） ----------
# 与 deployments/docker-compose.yml 中的服务名 / 端口保持一致
DB_HOST=localhost
DB_PORT=5432
DB_USER=mindos
DB_PASSWORD=mindos_dev_password
DB_NAME=mindos
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_PING_TIMEOUT=3s          # 启动时数据库连通性检查超时
DB_LOG_SQL=true             # 打印每条 SQL（观察 GORM 生成的 SQL 用，生产务必关闭）

# ---------- Redis（按需启用，当前未接入） ----------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=7
REDIS_POOL_SIZE=20

# ---------- RabbitMQ（任务队列：只负责叫醒，状态仍在 jobs 表） ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672                 # 管理界面在 15672
RABBITMQ_USER=mindos
RABBITMQ_PASSWORD=mindos_dev_password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=mindos.jobs
RABBITMQ_PREFETCH=2                # 与 JOB_WORKERS 一致；取多了停得慢

# ---------- 原始文档存储（MinIO，唯一后端） ----------
# 没有 driver 开关，也没有本地目录备选：原文是重索引/重算向量的唯一依据，
# 不能跟着应用容器的磁盘一起消失（容器重建、换机器、多实例都会让原文丢）。
# 以下 MinIO 项全部必填，缺一项服务直接起不来；bucket 启动时自动创建。
STORAGE_MAX_UPLOAD_BYTES=10485760   # 单次导入上限（10 MiB），服务端强制

MINIO_ENDPOINT=localhost:9000       # host:port，不带协议；https 用 MINIO_USE_SSL=true
MINIO_ACCESS_KEY=mindos             # 同时作为容器内的 MINIO_ROOT_USER
MINIO_SECRET_KEY=mindos_dev_password # 同时作为容器内的 MINIO_ROOT_PASSWORD
MINIO_BUCKET=mindos                 # 启动时自动创建，不需要手工建
MINIO_USE_SSL=false
MINIO_PORT=9000                     # compose 映射到宿主机的 S3 端口
MINIO_CONSOLE_PORT=9001             # 控制台 http://localhost:9001

# ---------- 本地运行数据 ----------
# 主密钥等运行期生成的文件放这里。目录不存在时会自动建（0700）。
MINDOS_DATA_DIR=.data
# 加密落库的模型 API Key 用的主密钥，base64 的 32 字节。
# 留空则在 MINDOS_DATA_DIR 下自动生成 master.key（0600）。
# 一旦生成就别删：删了库里已存的 Key 全部解不开，只能重新填。
MINDOS_MASTER_KEY=

# ---------- 对话模型 ----------
# 不在这里配：对话模型由用户在 Settings 页添加，存在 chat_models 表里，
# 不再读环境变量。服务端不内置任何默认模型（换模型不该需要发版或重启）。

# 向量模型：不配也能用，文档照常导入，只是不做语义检索（状态显示 skipped）
# 维度固定 1024（对齐 bge-m3），与迁移里的 vector(1024) 绑定，换模型要改列类型
#
# 三个字段要么全配、要么全空——只填一半会启动失败，所以这里留空，
# 下面两套是可直接抄的值（抄完记得把 EMBEDDING_API_KEY 一起填上）：
#
#   硅基流动（免费模型，需实名注册后建 Key）：
#     EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
#     EMBEDDING_MODEL=BAAI/bge-m3
#     EMBEDDING_API_KEY=sk-...
#
#   本机 Ollama（全离线，Key 填任意非空串）：
#     EMBEDDING_API_BASE=http://localhost:11434/v1
#     EMBEDDING_MODEL=bge-m3
#     EMBEDDING_API_KEY=ollama
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT=60s         # 单次请求超时；本机 CPU 推理要放宽
EMBEDDING_BATCH_SIZE=10       # 每请求文本条数；百炼等厂商上限就是 10，别调大

# ---------- RAG 问答 ----------
# 单次工具检索的默认条数与硬上限（工具内部还会压到 10）。
# 检索已经移进 agent：由模型决定查几次，这里只是每次的上限。
RAG_TOP_K=8
# 一次问答的整体超时，覆盖模型 + 工具调用。
RAG_TIMEOUT=60s

# ---------- Agent 预算（三重上限，缺一不允许运行） ----------
AGENT_MAX_STEPS=30            # 单次运行最大步数
AGENT_TOKEN_BUDGET=200000     # 单次运行最大 token 消耗
AGENT_RUN_TIMEOUT=5m          # 单次运行整体超时

# ---------- 后台任务链路 ----------
# 单进程并发消费的消息数：不是越大越好，并发上去后瓶颈会移到数据库连接池
JOB_WORKERS=2                 # 1-64，同时决定 RABBITMQ_PREFETCH

# 兜底扫描：处理"消息已 ack、消费端却崩了"的任务（broker 管不到这种情况）
REAPER_INTERVAL=30s           # 扫描间隔
REAPER_STALE_AFTER=2m         # 多久没动过算卡住；至少 30s，且应远大于一次正常处理
REAPER_RETENTION=168h         # 已投递消息与去重记录的保留期（7 天）
